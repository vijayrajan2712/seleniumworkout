# Leave both unset to run in MOCK mode (simulated data, no credentials needed).
# Set both to switch to LIVE mode against your real Dhan account (read-only market data -
# this app never places orders).
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# Optional tuning
PORT=4100
# Sequential requests/sec against Dhan's historical data API during bootstrap. Lower this
# if you hit rate-limit errors during the ~500-symbol daily-history fetch.
DHAN_REQUESTS_PER_SECOND=3
# Limit how many Nifty 500 symbols to scan (0 = all 500). Useful for a quick test run.
UNIVERSE_LIMIT=0
